# /srv/tbfernandes/.env na EC2 (chmod 600, nunca no git). Lido pelo compose.prod.yaml e pelo backend.
DB_NAME=tbfernandes
DB_USERNAME=tbf
DB_PASSWORD=

TBF_CORS_ORIGINS=https://software.tbfernandes.com.br
TBF_COOKIE_DOMAIN=.software.tbfernandes.com.br
TBF_TIME_ZONE=America/Sao_Paulo
LOG_FORMAT=text

TBF_AUTH_MODE=session
TBF_AUTH_BOOTSTRAP_EMAIL=
TBF_AUTH_BOOTSTRAP_PASSWORD=
TBF_AUTH_BOOTSTRAP_NAME=
TBF_SESSION_SECRET=

TBF_ASSISTANT_MODEL=none
TBF_ASSISTANT_MODEL_NAME=
TBF_ASSISTANT_MODEL_BASE_URL=
TBF_ASSISTANT_MODEL_API_KEY=
ANTHROPIC_API_KEY=
TBF_ASSISTANT_EMBEDDING=none
TBF_ASSISTANT_EMBEDDING_NAME=
VOYAGE_API_KEY=
TBF_ASSISTANT_TRACING=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

TBF_BACKUP_INTERVAL=600
