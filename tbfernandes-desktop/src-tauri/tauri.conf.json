{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TBFernandes",
  "version": "0.1.0",
  "identifier": "com.tbfernandes.desktop",
  "build": {
    "frontendDist": "../../tbfernandes-frontend/out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "script-src": "'self' https://*.pluggy.ai",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "frame-src": "https://*.pluggy.ai",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TBFernandes",
    "category": "Productivity",
    "shortDescription": "Gestão pessoal: trabalho, conhecimento, metas e finanças",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/backend/": "backend/",
      "resources/postgres/": "postgres/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
