# Copy to .env.local (not committed). Every variable is checked at startup
# (src/infrastructure/environments/schemas); the defaults match compose.yaml.

# dev (sample data), prod (session login, nothing defaulted), desktop (Windows app), test
TBF_PROFILE=dev
PORT=8080
TBF_TIME_ZONE=America/Sao_Paulo
TBF_CORS_ORIGINS=http://localhost:3000
# text or json (one JSON object per line, for log collectors)
LOG_FORMAT=text

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=tbf
DB_PASSWORD=tbf
DB_NAME=tbfernandes

# single-user (no login) or session (login; forced in prod)
TBF_AUTH_MODE=single-user
TBF_AUTH_BOOTSTRAP_EMAIL=
TBF_AUTH_BOOTSTRAP_PASSWORD=
TBF_AUTH_BOOTSTRAP_NAME=
TBF_SESSION_SECRET=
TBF_COOKIE_SECURE=false

# Open Finance (Pluggy). Off by default (RN-15); credentials at https://dashboard.pluggy.ai
PLUGGY_ENABLED=false
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Sent back by Pluggy on every webhook; empty refuses every webhook.
PLUGGY_WEBHOOK_SECRET=

# Assistant. Off by default: answers with rules, queries and keyword search over notes.
# anthropic: a language model turns questions into queries and writes the answers.
TBF_ASSISTANT_MODEL=none
TBF_ASSISTANT_MODEL_NAME=claude-opus-5-5
ANTHROPIC_API_KEY=
# voyage: embeddings for retrieval by meaning (AST-04).
TBF_ASSISTANT_EMBEDDING=none
TBF_ASSISTANT_EMBEDDING_NAME=voyage-3.5-lite
VOYAGE_API_KEY=
