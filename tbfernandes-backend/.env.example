# Copy to .env.local (not committed). Every variable is checked at startup
# (src/infrastructure/environments/schemas); the defaults match compose.yaml.

# dev (sample data), prod (session login, nothing defaulted), desktop (Windows app), test
TBF_PROFILE=dev
PORT=8080
TBF_TIME_ZONE=America/Sao_Paulo
TBF_CORS_ORIGINS=http://localhost:3000
# text or json (one JSON object per line, for log collectors)
LOG_FORMAT=text

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=tbf
DB_PASSWORD=tbf
DB_NAME=tbfernandes

# single-user (no login) or session (login; forced in prod)
TBF_AUTH_MODE=single-user
TBF_AUTH_BOOTSTRAP_EMAIL=
TBF_AUTH_BOOTSTRAP_PASSWORD=
TBF_AUTH_BOOTSTRAP_NAME=
# Signs the login JWT (openssl rand -hex 32). Empty: a new one on each start.
TBF_JWT_SECRET=
TBF_JWT_TTL_SECONDS=604800
TBF_LOGIN_ATTEMPTS_PER_MINUTE=5
# true: the bootstrap password replaces the current one (forgotten password). Back to false after.
TBF_AUTH_BOOTSTRAP_RESET_PASSWORD=false
TBF_COOKIE_SECURE=false
# Frontend and API on different subdomains: the parent domain, e.g. .software.tbfernandes.com.br
TBF_COOKIE_DOMAIN=

# Open Finance (Pluggy). Off by default (RN-15); credentials at https://dashboard.pluggy.ai
PLUGGY_ENABLED=false
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Sent back by Pluggy on every webhook; empty refuses every webhook.
PLUGGY_WEBHOOK_SECRET=

# Assistant. Off by default: answers with rules, queries and keyword search over notes.
# openai-compatible: Groq by default (free tier, key at https://console.groq.com/keys,
# openai/gpt-oss-120b); xAI (https://api.x.ai/v1) or Ollama (http://localhost:11434/v1)
# by changing the URL. anthropic: Claude (claude-opus-5-5), with ANTHROPIC_API_KEY.
# Empty names and URLs take the provider's default.
TBF_ASSISTANT_MODEL=none
TBF_ASSISTANT_MODEL_NAME=
TBF_ASSISTANT_MODEL_BASE_URL=
TBF_ASSISTANT_MODEL_API_KEY=
ANTHROPIC_API_KEY=
# Embeddings for retrieval by meaning (AST-04). ollama: free and local, bge-m3 by default
# (`docker compose --profile ai up -d ollama ollama-models`). voyage: voyage-3.5-lite.
TBF_ASSISTANT_EMBEDDING=none
TBF_ASSISTANT_EMBEDDING_NAME=
OLLAMA_BASE_URL=http://localhost:11434
VOYAGE_API_KEY=
# langfuse: one trace per question, with each model call, embedding and the retrieval (AST-05).
# Keys in the Langfuse project, Settings > API Keys. EU: https://cloud.langfuse.com,
# US: https://us.cloud.langfuse.com. E-mails and CPFs are masked before they are sent.
TBF_ASSISTANT_TRACING=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
