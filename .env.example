# Copy to .env (never committed). Everything here is optional for local use.

# Host ports.
TBF_HTTP_PORT=80
TBF_DB_PORT=5434

# dev: sample data and no login. prod: no sample data and login required (set the values below).
TBF_PROFILE=dev
TBF_DB_PASSWORD=tbf
TBF_AUTH_MODE=single-user
TBF_AUTH_BOOTSTRAP_EMAIL=
TBF_AUTH_BOOTSTRAP_PASSWORD=
TBF_AUTH_BOOTSTRAP_NAME=
# true when nginx is served over HTTPS.
TBF_COOKIE_SECURE=false
# Signs the session cookie. Empty: a new one on each start, which signs everyone out.
TBF_SESSION_SECRET=

# Assistant. Off by default: answers with rules, queries and keyword search.
# Free setup: Groq (free tier, key at https://console.groq.com/keys) writes the answers and
# Ollama (COMPOSE_PROFILES=ai) makes the embeddings on this machine:
#   COMPOSE_PROFILES=ai
#   TBF_ASSISTANT_MODEL=openai-compatible
#   TBF_ASSISTANT_MODEL_API_KEY=gsk_...
#   TBF_ASSISTANT_EMBEDDING=ollama
# openai-compatible: Groq by default; xAI (https://api.x.ai/v1) or Ollama (http://ollama:11434/v1)
# by changing the URL. anthropic: Claude, with ANTHROPIC_API_KEY.
TBF_ASSISTANT_MODEL=none
TBF_ASSISTANT_MODEL_NAME=
TBF_ASSISTANT_MODEL_BASE_URL=
TBF_ASSISTANT_MODEL_API_KEY=
ANTHROPIC_API_KEY=
# ollama (bge-m3 by default) or voyage: retrieval by meaning in notes and snippets.
TBF_ASSISTANT_EMBEDDING=none
TBF_ASSISTANT_EMBEDDING_NAME=
VOYAGE_API_KEY=
# langfuse: traces of each question (keys in Settings > API Keys of the Langfuse project).
TBF_ASSISTANT_TRACING=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Open Finance (docs/como-rodar.md).
PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
NEXT_PUBLIC_PLUGGY_SANDBOX=false
