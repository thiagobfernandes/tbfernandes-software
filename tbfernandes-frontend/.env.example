# Public base URL of the Spring Boot API. Only put browser-safe values in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://localhost:8080
# "local" (default): simulated data in this browser. "api": read and write through the API above.
NEXT_PUBLIC_DATA_SOURCE=local
# "true" shows Pluggy's test banks in the connect widget. Never on in production.
NEXT_PUBLIC_PLUGGY_SANDBOX=false
